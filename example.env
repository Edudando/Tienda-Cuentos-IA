# Copiá este archivo como .env y completá los valores. El .env NUNCA se sube a Git.
# (Los comentarios van en su propia línea para que Docker y Python lean igual el archivo.)

# ---------- IA ----------
# Orden del fallback. "mock" = simulación sin IA real (para probar sin claves).
IA_PROVEEDORES=gemini,groq,ollama
# Clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=poner cllave gemini
GEMINI_MODEL=gemini-flash-latest
# Clave gratuita en https://console.groq.com/keys
GROQ_API_KEY= poner clave de groq
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=llama3.2
N8N_ENCRYPTION_KEY=poner clave de n8n
# ---------- Telegram ----------
# Token que da @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=
# Usuario del bot sin @, por ejemplo CuentosIADemoBot
TELEGRAM_BOT_USERNAME=
# @nombre_del_canal (el bot tiene que ser administrador del canal)
TELEGRAM_CHANNEL_ID=
# Tu chat id personal, para los avisos al admin (ver README)
ADMIN_CHAT_ID=

# ---------- Negocio ----------
PRECIO_POR_DEFECTO=0
ALIAS_TRANSFERENCIA=cuentos.ia.demo (dato ficticio)